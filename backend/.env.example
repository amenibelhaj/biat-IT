# Copier en « .env » et renseigner. Ce fichier ne doit pas être versionné.

# --- Base de données -------------------------------------------------
# Serveur interne BIAT :
DATABASE_URL=postgresql://biat:motdepasse@10.x.x.x:5432/biat_assets
# Hébergement managé (Neon, Render) :
# DATABASE_URL=postgresql://user:pass@hote/base?sslmode=require

# Chiffrement de la connexion à la base :
#   disable  serveur interne sur réseau privé
#   require  hébergement managé
#   verify   vérification du certificat, avec DATABASE_CA_FILE
# Laissé vide, le mode est déduit de l'adresse : une adresse privée
# (localhost, 10.x, 172.16-31.x, 192.168.x, .local) n'active pas TLS.
DATABASE_SSL=

# Certificat de l'autorité interne, si DATABASE_SSL=verify
# DATABASE_CA_FILE=/etc/ssl/certs/biat-ca.crt

# --- Serveur ---------------------------------------------------------
PORT=5000

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# À laisser VIDE lorsque l'interface est servie par Nginx sur la même
# origine (déploiement interne) : aucune restriction n'est alors utile.
FRONTEND_URL=

# Taille du pool de connexions à la base
DB_POOL_MAX=10
