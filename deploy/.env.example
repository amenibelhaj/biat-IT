# Copier ce fichier en « .env » dans le dossier deploy/, puis renseigner
# le mot de passe. Ce fichier ne doit pas être versionné.

# --- Base de données -------------------------------------------------
POSTGRES_DB=biat_assets
POSTGRES_USER=biat
POSTGRES_PASSWORD=                 # OBLIGATOIRE — mot de passe fort

# --- Publication -----------------------------------------------------
# Port exposé par la VM. 80 par défaut ; utiliser 8080 si le port 80 est
# déjà pris sur la machine.
HTTP_PORT=80

# Laisser vide : l'interface et l'API partagent la même origine grâce au
# relais Nginx, aucune restriction CORS n'est nécessaire.
FRONTEND_URL=

# --- Proxy d'entreprise ----------------------------------------------
# À renseigner uniquement si la VM ne sort pas directement vers Internet.
# Ces valeurs sont utilisées pendant la construction, pour npm.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,backend
