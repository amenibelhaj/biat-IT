/* Application shell: fixed sidebar, scrolling content area. */

.shell {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* ---------------- Sidebar ---------------- */
.sidebar {
  width: 236px;
  flex-shrink: 0;
  background: var(--navy-900);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 20px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, .09);
}
.brand-mark {
  width: 38px; height: 38px;
  flex-shrink: 0;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--accent) 0%, #0d6a8a 100%);
  color: #fff;
  font-size: 12px;
  font-weight: 750;
  letter-spacing: .02em;
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-title { color: #fff; font-size: 13.5px; font-weight: 640; line-height: 1.25; }
.brand-sub   { color: rgba(255,255,255,.52); font-size: 11px; margin-top: 2px; }

.side-nav { flex: 1; padding: 14px 10px; }
.nav-group + .nav-group { margin-top: 18px; }
.nav-group-label {
  font-size: 10px;
  font-weight: 650;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(255,255,255,.38);
  padding: 0 10px 7px;
}
.nav-item {
  display: block;
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  color: rgba(255,255,255,.76);
  font-family: var(--font);
  font-size: 13px;
  font-weight: 520;
  padding: 8px 10px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: background .14s ease, color .14s ease;
}
.nav-item:hover { background: rgba(255,255,255,.07); color: #fff; }
.nav-item.active {
  background: var(--accent);
  color: #fff;
  font-weight: 600;
}

.side-foot {
  padding: 14px 12px 18px;
  border-top: 1px solid rgba(255,255,255,.09);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.side-foot .input {
  background: rgba(255,255,255,.08);
  border-color: rgba(255,255,255,.16);
  color: #fff;
  min-width: 0;
  width: 100%;
  font-size: 12.5px;
}
.side-foot .input option { color: var(--ink); }

/* ---------------- Content ---------------- */
.content {
  flex: 1;
  overflow-y: auto;
  padding: 26px 30px 44px;
}

@media (max-width: 860px) {
  .shell { flex-direction: column; height: auto; }
  .sidebar { width: 100%; }
  .side-nav { display: flex; flex-wrap: wrap; gap: 6px; }
  .nav-group { margin-top: 0 !important; }
  .content { padding: 18px 16px 36px; }
}
